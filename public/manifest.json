{
  "manifest_version": 3,
  "name": "Screen & Camera Recorder",
  "version": "1.0.0",
  "description": "Production-ready, simple, and private screen and camera recorder for Chrome.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "action": {
    "default_title": "Screen & Camera Recorder",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
